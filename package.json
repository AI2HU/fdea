{
  "name": "fdea-agents",
  "version": "0.1.0",
  "description": "Forward Deploy Engineering Anything: turn process documentation into a tailor-made, production-ready AdonisJS application from your agent or terminal.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "forward-deployed-engineering",
    "adonisjs",
    "code-generation",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agents",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fdea": "scripts/fdea.mjs",
    "fdea-agents": "scripts/fdea.mjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.16.0",
  "files": [
    "dist",
    "scripts/fdea.mjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node scripts/fdea.mjs mcp",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "commander": "^15.0.0",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
